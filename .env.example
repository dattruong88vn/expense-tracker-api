# Copy to .env and fill in the values. Never commit .env.
NODE_ENV=development
PORT=3000
# Local MongoDB started by docker compose
MONGODB_URI=mongodb://localhost:27017/expense-tracker
# At least 32 random characters, for example: openssl rand -hex 32
JWT_SECRET=
# Session validity (FR-05)
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed web origins
CORS_ORIGINS=http://localhost:5173
# OAuth 2.0 Web client ID from Google Cloud Console
GOOGLE_CLIENT_ID=
